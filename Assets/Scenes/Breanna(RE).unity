  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 786635473119094666}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b40beeb965e5d9419bf817d6f7d59bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  go_to_next_node: 1
  executed_from_load: 0
  actor_name_from: 0
  actor: Breanna
  speaker_name_from: 0
  textbox_title: Breanna
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: It just feels like sometimes my professors schedule their exams without even
    considering what else their students might be doing then.
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
  log_text: 1
  log_category: Default
  done_printing: 0
  no_voice_playing: 0
  done_voice_clip: 0
--- !u!114 &786635473124233465
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 786635473124233468}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b40beeb965e5d9419bf817d6f7d59bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  go_to_next_node: 1
  executed_from_load: 0
  actor_name_from: 0
  actor: Breanna
  speaker_name_from: 0
  textbox_title: Breanna
  fetch_localized_stat_value: 0
  dialogue_from: 0
  localized_key: 
  text: "Because <i>of course</i> the professor just assumes I won\u2019t have anything
    else to do <i>on finals week</i>."
  talking_beeps: {fileID: 0}
  darken_all_other_characters: 1
  bring_speaker_to_front: 1
  clear_text_after: 0
  log_text: 1
  log_category: Default
  done_printing: 0
  no_voice_playing: 0
  done_voice_clip: 0
